		DisplayName: True Lunar Bar
		Description: True Lunar Bar
	}
}

Configs: {
	CMoonConfig: {
		DisplayName: C-Moon Potion Settings

		DisableVerticalVelocity: {
			Label: Lock Vertical Displacement (Zero Y-axis Velocity)
			Tooltip: When enabled, forces vertical speed (Y-axis) to zero while under the effect of C-Moon Potion, allowing complete horizontal fall. When disabled, retains original vertical inertia and movement.
		}
	}
}

