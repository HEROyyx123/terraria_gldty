	BlackHoleStone: {
		DisplayName: Black Hole Stone
		Tooltip: Takes effect while in the inventory, Increases item pickup range and filters item pickups, Right-click to open settings
	}

	EnchantingWorkshop: {
		DisplayName: Enchanting Workshop
		Tooltip: Functions as a Tinkerer's Workshop, Allows direct crafting of weapons or accessories with specified modifiers, Right-click after placing to open the enchanting interface
	}

	CMoonPotion: {
		Tooltip: Allows you to be affected by horizontal gravity and fall sideways
		DisplayName: C Moon Potion
	}

	TinyKingPotion: {
		Tooltip:
			'''
			Grants the authority of "Little King"
			When taking fatal damage, transfers the damage to a random female NPC to negate death
			The potion's effect wears off immediately upon activation
			"My heart beats alongside theirs."
			'''
		DisplayName: Little King Potion
	}

	SpaceMovePotion: {
		DisplayName: Teleportation Potion: Space Move
		Tooltip:
			'''
			"Calculating 11-dimensional spatial coordinates..."
			Grants 'Space Movement'
			Allows instant teleportation to any location by right-clicking on the fullscreen map
			'Kuroko's ability isn't meant for peeping!'
			'''
	}

	BambooCicada: {
		Tooltip:
			'''
			Empty stomach, loud voice, and choked by string
			That's right, it's the Bamboo Cicada
			Grants 'Fishy Resonance' while held
			"Ah this this ah ah we this this ah ah ah this we this this ah"
			'''
		DisplayName: Bamboo Cicada
	}

	SoulChain: {
		DisplayName: Soul Chain
		Tooltip: ""
	}

	BridgeBuilderItem: {
		Tooltip:
			'''
			[c/56B4E9:[Building Tool]]
			Shows a builder guide preview when held
			Left click to construct platforms and light sources automatically based on settings
			Supports custom length, direction, hammering shapes, and lighting intervals
			Supports clearing upper and lower tiles up to 10 blocks
			Right click to toggle the configuration UI
			'''
		DisplayName: Bridge & Platform Builder
	}

	MagicStoragePack: {
		Tooltip: Containers above the sky may serve a different purpose.
		DisplayName: Magic Storage Pack
	}

	FakeCopperShortsword: {
		Tooltip: Watch and learn, THIS is how you use Hallowed Bars.
		DisplayName: True Hallowed Bar
	}

	AnglerCage: {
		Tooltip: ""
		DisplayName: AnglerCage
