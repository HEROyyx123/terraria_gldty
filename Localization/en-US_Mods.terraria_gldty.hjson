		Description: Your fate is bound to the town's female NPCs
		DisplayName: Little King
	}

	SpaceMoveBuff: {
		Description: Space Movement
		DisplayName: Open the fullscreen map and right-click to instantly teleport to the selected location
	}

	SprainedAnkleDebuff: {
		Description: Severe ankle pain! Movement speed plummets and dashing is disabled.
		DisplayName: Sprained Ankle
	}

	FishyResonanceBuff: {
		Description: Hypnotic fish sounds brainwash you, boosting movement and attack speed—but watch your step!
		DisplayName: Fishy Resonance
	}

